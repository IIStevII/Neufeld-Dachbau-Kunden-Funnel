<script>
  // ── WhatsApp-Link mit Nummer befüllen
  document.getElementById('whatsappLink').href = 'https://wa.me/' + WHATSAPP_NUMBER;

  const TOTAL = 6;
  let current = 1;
  const selections = { s1: null, s2: null, s3: null, s4: null };

  function selectOption(el, group) {
    const step = group.replace('s', '');
    document.querySelectorAll('#step' + step + ' .option-btn')
      .forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    selections[group] = el.dataset.val;
  }

  function updateProgress(step) {
    const pct = Math.round((step / TOTAL) * 100);
    document.getElementById('progressBar').style.width = pct + '%';
    document.getElementById('progressLabel').textContent = 'Schritt ' + step + ' von ' + TOTAL;
  }

  function showStep(n) {
    document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
    document.getElementById('step' + n).classList.add('active');
    updateProgress(n);
    current = n;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function nextStep(from) {
    if (from === 1 && !selections.s1) { showErr('err1'); return; }
    if (from === 2 && !selections.s2) { showErr('err2'); return; }
    if (from === 3 && !selections.s3) { showErr('err3'); return; }
    if (from === 4 && !selections.s4) { showErr('err4'); return; }
    if (from === 5) {
      const plz = document.getElementById('plz').value.trim();
      if (!plz || plz.length < 4) { showErr('err5'); return; }
    }
    hideErrs();
    showStep(from + 1);
  }

  function prevStep(from) { hideErrs(); showStep(from - 1); }

  function showErr(id) { hideErrs(); document.getElementById(id).style.display = 'block'; }
  function hideErrs() { document.querySelectorAll('.error-msg').forEach(e => e.style.display = 'none'); }

  async function submitForm() {
    const name     = document.getElementById('name').value.trim();
    const telefon  = document.getElementById('telefon').value.trim();
    const email    = document.getElementById('email').value.trim();

    if (!name || !telefon || !email) { showErr('err6'); return; }

    const btn = document.getElementById('submitBtn');
    btn.textContent = 'Wird gesendet …';
    btn.disabled = true;

    const payload = {
      leistung:    selections.s1,
      gebaeude:    selections.s2,
      dachflaeche: selections.s3,
      zeitrahmen:  selections.s4,
      plz:         document.getElementById('plz').value.trim(),
      ort:         document.getElementById('ort').value.trim(),
      name:        name,
      telefon:     telefon,
      email:       email,
      nachricht:   document.getElementById('nachricht').value.trim()
    };

    try {
      const res = await fetch(SUPABASE_URL + '/rest/v1/leads', {
        method: 'POST',
        headers: {
          'apikey':        SUPABASE_ANON,
          'Authorization': 'Bearer ' + SUPABASE_ANON,
          'Content-Type':  'application/json',
          'Prefer':        'return=minimal'
        },
        body: JSON.stringify(payload)
      });

      if (res.ok || res.status === 201) {
        document.querySelectorAll('.step').forEach(s => s.style.display = 'none');
        document.getElementById('progressBar').style.width = '100%';
        document.getElementById('progressLabel').textContent = 'Anfrage gesendet ✓';
        document.getElementById('successScreen').style.display = 'block';
      } else {
        const err = await res.text();
        console.error('Supabase Fehler:', err);
        btn.textContent = '✓ Kostenlos anfragen';
        btn.disabled = false;
        alert('Es gab ein Problem beim Senden. Bitte versuchen Sie es erneut.');
      }
    } catch (e) {
      console.error(e);
      btn.textContent = '✓ Kostenlos anfragen';
      btn.disabled = false;
      alert('Keine Verbindung. Bitte prüfen Sie Ihre Internetverbindung.');
    }
  }
</script>
</body>
</html>
